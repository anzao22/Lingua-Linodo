SELECT f.numero_factura, c.razon_social, p.nombre AS plan,
       f.subtotal, f.valor_iva, f.total, f.estado
FROM facturas f
JOIN clientes c ON f.id_cliente = c.id_cliente
JOIN lineas_factura lf ON lf.id_factura = f.id_factura
JOIN planes p ON lf.id_plan = p.id_plan;
