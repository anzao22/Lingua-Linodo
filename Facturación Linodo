-- ====================================
-- CREACIÓN DE TABLAS
-- ====================================

CREATE TABLE clientes (
    id_cliente     INT PRIMARY KEY AUTO_INCREMENT,
    razon_social   VARCHAR(150) NOT NULL,
    identificacion VARCHAR(20)  NOT NULL UNIQUE,
    tipo_id        ENUM('CC','NIT','CE','PAS') NOT NULL DEFAULT 'CC',
    email          VARCHAR(150) NOT NULL,
    direccion      VARCHAR(200),
    telefono       VARCHAR(20),
    estado         ENUM('activo','inactivo','bloqueado') NOT NULL DEFAULT 'activo',
    fecha_registro DATETIME DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE planes (
    id_plan        INT PRIMARY KEY AUTO_INCREMENT,
    codigo         VARCHAR(20) NOT NULL UNIQUE,
    nombre         VARCHAR(100) NOT NULL,
    descripcion    TEXT,
    precio_base    DECIMAL(12,2) NOT NULL,
    porcentaje_iva DECIMAL(5,2)  NOT NULL DEFAULT 19.00,
    activo         BOOLEAN NOT NULL DEFAULT TRUE
);

CREATE TABLE facturas (
    id_factura     INT PRIMARY KEY AUTO_INCREMENT,
    numero_factura VARCHAR(20) NOT NULL UNIQUE,
    id_cliente     INT NOT NULL,
    fecha_emision  DATETIME DEFAULT CURRENT_TIMESTAMP,
    fecha_vence    DATE,
    subtotal       DECIMAL(12,2) NOT NULL DEFAULT 0.00,
    valor_iva      DECIMAL(12,2) NOT NULL DEFAULT 0.00,
    total          DECIMAL(12,2) NOT NULL DEFAULT 0.00,
    estado         ENUM('activa','anulada','pagada') NOT NULL DEFAULT 'activa',
    observaciones  TEXT,
    FOREIGN KEY (id_cliente) REFERENCES clientes(id_cliente)
);

CREATE TABLE lineas_factura (
    id_linea        INT PRIMARY KEY AUTO_INCREMENT,
    id_factura      INT NOT NULL,
    id_plan         INT NOT NULL,
    cantidad        INT NOT NULL DEFAULT 1,
    precio_unitario DECIMAL(12,2) NOT NULL,
    porcentaje_iva  DECIMAL(5,2)  NOT NULL,
    FOREIGN KEY (id_factura) REFERENCES facturas(id_factura),
    FOREIGN KEY (id_plan)    REFERENCES planes(id_plan)
);

CREATE TABLE historial_estados_factura (
    id_historial    INT PRIMARY KEY AUTO_INCREMENT,
    id_factura      INT NOT NULL,
    estado_anterior ENUM('activa','anulada','pagada') NOT NULL,
    estado_nuevo    ENUM('activa','anulada','pagada') NOT NULL,
    fecha_cambio    DATETIME DEFAULT CURRENT_TIMESTAMP,
    motivo          TEXT,
    FOREIGN KEY (id_factura) REFERENCES facturas(id_factura)
);

